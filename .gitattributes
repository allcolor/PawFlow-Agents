# Force LF line endings for all text files (cross-platform consistency)
* text=auto eol=lf

# Ensure these are always LF
*.py text eol=lf
*.js text eol=lf
*.ts text eol=lf
*.json text eol=lf
*.html text eol=lf
*.css text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.sh text eol=lf

# Reviewed generated sources preserve upstream bytes and unified-diff context.
packages/pawflow.avatar-runtime.pfpdir/content/ui/avatar-vendor.js whitespace=-trailing-space
scripts/avatar_vendor/*.patch whitespace=-trailing-space

# Preserve the reviewed RxJS bundle and license bytes.
tasks/io/chat_ui/vendor/rxjs-7.8.2.umd.min.js whitespace=-trailing-space
tasks/io/chat_ui/vendor/rxjs-LICENSE.txt whitespace=-trailing-space

# Binary files
*.png binary
*.mp4 binary
*.jpg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
