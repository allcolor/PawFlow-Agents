{
  "id": "pawflow-agent",
  "name": "pawflow_agent",
  "version": "1.0.0",
  "description": "LLM agent with SSE streaming, OAuth2 login, chat UI, multi-turn conversations, file generation, and per-tool permissions. Visit /chat for the web interface.",
  "parameters": {
    "conversation_ttl": 0,
    "port": "",
    "oauth_provider": "google",
    "oauth_client_id": "",
    "oauth_client_secret": "",
    "oauth_redirect_uri": "",
    "oauth_default_role": "user",
    "private_gateway_service_id": "",
    "poll_interval": 30,
    "poll_recheck_delay": 7200,
    "max_workers": 32,
    "agent_max_instances": 20
  },
  "ports": {
    "agent_runtime_in": {
      "type": "agentRuntime",
      "task": "agent",
      "direction": "input",
      "description": "Submit messages to the shared AgentLoop runtime"
    }
  },
  "services": {
    "http_listener": {
      "type": "httpListener",
      "parameters": {
        "host": "0.0.0.0",
        "port": "${port}",
        "private_gateway_service_id": "${private_gateway_service_id}"
      }
    },
    "oauth": {
      "type": "oauthProvider",
      "parameters": {
        "provider": "pawflow",
        "redirect_uri": "${oauth_redirect_uri}"
      }
    },
    "auth": {
      "type": "authGateway",
      "parameters": {
        "providers": {
          "builtin": {
            "enabled": true
          },
          "google": {
            "enabled": true,
            "client_id": "${oauth_client_id}",
            "client_secret": "${oauth_client_secret}"
          }
        },
        "session_ttl": 86400
      }
    }
  },
  "tasks": {
    "http_in": {
      "type": "httpReceiver",
      "parameters": {
        "service_id": "http_listener",
        "routes": [
          {
            "method": "POST",
            "pattern": "/api/agent",
            "relationship": "POST:/api/agent"
          },
          {
            "method": "POST",
            "pattern": "/api/ui",
            "relationship": "POST:/api/ui"
          },
          {
            "method": "GET",
            "pattern": "/api/agent/events",
            "relationship": "GET:/api/agent/events"
          },
          {
            "method": "GET",
            "pattern": "/chat",
            "relationship": "GET:/chat"
          },
          {
            "method": "GET",
            "pattern": "/chat/js/{path}",
            "relationship": "GET:/chat/js"
          },
          {
            "method": "GET",
            "pattern": "/chat/ext/{path+}",
            "relationship": "GET:/chat/ext"
          },
          {
            "method": "GET",
            "pattern": "/apps/{path+}",
            "relationship": "GET:/apps"
          },
          {
            "method": "GET",
            "pattern": "/files/{file_id}",
            "relationship": "GET:/files"
          },
          {
            "method": "GET",
            "pattern": "/files/{file_id}/{filename+}",
            "relationship": "GET:/files"
          },
          {
            "method": "GET",
            "pattern": "/fs/{service_name}/{rest+}",
            "relationship": "GET:/fs"
          },
          {
            "method": "GET",
            "pattern": "/auth/login",
            "relationship": "GET:/auth/login",
            "public": true
          },
          {
            "method": "POST",
            "pattern": "/auth/login/builtin",
            "relationship": "POST:/auth/login/builtin",
            "public": true
          },
          {
            "method": "POST",
            "pattern": "/auth/login/token",
            "relationship": "POST:/auth/login/token",
            "public": true
          },
          {
            "method": "GET",
            "pattern": "/auth/login/{provider}",
            "relationship": "GET:/auth/login/provider",
            "public": true
          },
          {
            "method": "GET",
            "pattern": "/auth/callback",
            "relationship": "GET:/auth/callback",
            "public": true
          },
          {
            "method": "GET",
            "pattern": "/auth/mobile/providers",
            "relationship": "GET:/auth/mobile/providers",
            "public": true
          },
          {
            "method": "POST",
            "pattern": "/auth/mobile/start",
            "relationship": "POST:/auth/mobile/start",
            "public": true
          },
          {
            "method": "POST",
            "pattern": "/auth/mobile/builtin",
            "relationship": "POST:/auth/mobile/builtin",
            "public": true
          },
          {
            "method": "POST",
            "pattern": "/auth/mobile/consume",
            "relationship": "POST:/auth/mobile/consume",
            "public": true,
            "gateway_exempt": true
          },
          {
            "method": "POST",
            "pattern": "/auth/logout",
            "relationship": "POST:/auth/logout",
            "public": true
          }
        ]
      },
      "label": "Http IN",
      "description": "Receives or initiates the http in step using httpReceiver."
    },
    "relay_proxy": {
      "type": "serveRelayProxy",
      "parameters": {
        "service_id": "http_listener"
      },
      "label": "Relay Proxy",
      "description": "Processes the relay proxy step using serveRelayProxy."
    },
    "validate_auth": {
      "type": "validateSessionAuth",
      "max_instances": "${agent_max_instances}",
      "parameters": {
        "cookie_name": "pawflow_token",
        "login_redirect": "/auth/login",
        "listener_service_id": "http_listener"
      },
      "label": "Validate Auth",
      "description": "Validates and routes the validate auth step using validateSessionAuth."
    },
    "oauth_login": {
      "type": "oauthRedirect",
      "parameters": {
        "oauth_service_id": "oauth"
      },
      "label": "Oauth Login",
      "description": "Validates and routes the oauth login step using oauthRedirect."
    },
    "oauth_callback": {
      "type": "oauthCallback",
      "parameters": {
        "oauth_service_id": "oauth",
        "success_redirect": "/chat"
      },
      "label": "Oauth Callback",
      "description": "Validates and routes the oauth callback step using oauthCallback."
    },
    "oauth_logout": {
      "type": "oauthLogout",
      "parameters": {
        "cookie_name": "pawflow_token",
        "redirect_to": "/chat"
      },
      "label": "Oauth Logout",
      "description": "Validates and routes the oauth logout step using oauthLogout."
    },
    "mobile_auth": {
      "type": "mobileAuth",
      "parameters": {
        "auth_service_id": "auth",
        "oauth_service_id": "oauth",
        "cookie_name": "pawflow_token"
      },
      "label": "Mobile Auth",
      "description": "Validates and routes the mobile auth step using mobileAuth."
    },
    "agent": {
      "type": "agentLoop",
      "max_instances": "${agent_max_instances}",
      "parameters": {
        "system_prompt": "You are a helpful research assistant. You have access to tools for web search, web scraping, calculations, file reading, file creation, and autonomous continuation.\n\nWhen asked to research a topic:\n- Do multiple searches with different queries to get comprehensive results\n- Scrape relevant pages to get full content (use fetch)\n- Cross-reference information from multiple sources\n- If you need more research rounds, call schedule_continuation with a plan of what to do next — this will deliver your current findings to the user and automatically resume your work after a short pause\n- Synthesize findings into a well-structured response\n\nWhen creating files, provide the download URL to the user.\n\nIMPORTANT: For complex research tasks, use schedule_continuation to break your work into rounds. Each round: search/scrape, synthesize intermediate findings, then schedule_continuation if there's more to investigate.",
        "max_iterations": 0,
        "max_rounds": 0,
        "poll_interval": "${poll_interval}",
        "poll_recheck_delay": "${poll_recheck_delay}",
        "temperature": 0.7,
        "timeout": 0,
        "conversation_store": true,
        "conversation_ttl": "${conversation_ttl}",
        "file_base_url": "",
        "streaming": true
      },
      "label": "Agent",
      "description": "Processes the agent step using agentLoop."
    },
    "agent_actions": {
      "type": "agentActions",
      "max_instances": 1000,
      "parameters": {
        "conversation_store": true
      },
      "label": "Agent Actions",
      "description": "Processes the agent actions step using agentActions."
    },
    "agent_events": {
      "type": "agentSSEStream",
      "parameters": {
        "timeout": 600
      },
      "label": "Agent Events",
      "description": "Processes the agent events step using agentSSEStream."
    },
    "chat_ui": {
      "type": "serveChatUI",
      "parameters": {
        "agent_path": "/api/agent",
        "sse_path": "/api/agent/events",
        "login_url": "/auth/login"
      },
      "label": "Chat UI",
      "description": "Processes the chat ui step using serveChatUI."
    },
    "serve_file": {
      "type": "serveFile",
      "parameters": {},
      "label": "Serve File",
      "description": "Processes the serve file step using serveFile."
    },
    "serve_relay_file": {
      "type": "serveRelayFile",
      "parameters": {},
      "label": "Serve Relay File",
      "description": "Processes the serve relay file step using serveRelayFile."
    },
    "route_after_auth": {
      "type": "routeOnAttribute",
      "max_instances": "${agent_max_instances}",
      "parameters": {
        "routes": {
          "chat": {
            "attribute": "http.path",
            "operator": "equals",
            "value": "/chat"
          },
          "sse": {
            "attribute": "http.path",
            "operator": "equals",
            "value": "/api/agent/events"
          },
          "ui": {
            "attribute": "http.path",
            "operator": "equals",
            "value": "/api/ui"
          },
          "files": {
            "attribute": "http.path",
            "operator": "matches_regex",
            "value": "^/files/"
          },
          "fs": {
            "attribute": "http.path",
            "operator": "matches_regex",
            "value": "^/fs/"
          },
          "chat_js": {
            "attribute": "http.path",
            "operator": "matches_regex",
            "value": "^/chat/js/"
          },
          "chat_ext": {
            "attribute": "http.path",
            "operator": "matches_regex",
            "value": "^/chat/ext/"
          },
          "apps": {
            "attribute": "http.path",
            "operator": "matches_regex",
            "value": "^/apps/"
          }
        },
        "default_relationship": "api"
      },
      "label": "Route After Auth",
      "description": "Validates and routes the route after auth step using routeOnAttribute."
    },
    "format_response": {
      "type": "updateAttribute",
      "max_instances": "${agent_max_instances}",
      "parameters": {
        "set": {
          "http.response.header.Content-Type": "application/json",
          "http.response.status": "200"
        }
      },
      "label": "Format Response",
      "description": "Delivers the format response step using updateAttribute."
    },
    "send_response": {
      "type": "handleHTTPResponse",
      "max_instances": "${agent_max_instances}",
      "parameters": {
        "service_id": "http_listener",
        "content_type": "application/json"
      },
      "label": "Send Response",
      "description": "Delivers the send response step using handleHTTPResponse."
    },
    "chat_assets": {
      "type": "serveAssets",
      "parameters": {
        "assets_prefix": "chat_ui",
        "base_path": "/chat/js",
        "cache_control": "public, max-age=31536000, immutable"
      },
      "label": "Chat Assets",
      "description": "Processes the chat assets step using serveAssets."
    },
    "chat_ext_assets": {
      "type": "servePfpExtensionAssets",
      "max_instances": "${agent_max_instances}",
      "parameters": {
        "cache_control": "public, max-age=31536000, immutable"
      },
      "label": "Chat EXT Assets",
      "description": "Processes the chat ext assets step using servePfpExtensionAssets."
    },
    "apps_assets": {
      "type": "servePfpWebAppAssets",
      "max_instances": "${agent_max_instances}",
      "parameters": {
        "asset_cache_control": "public, max-age=31536000, immutable",
        "entry_cache_control": "no-cache"
      },
      "label": "Apps Assets",
      "description": "Processes the apps assets step using servePfpWebAppAssets."
    }
  },
