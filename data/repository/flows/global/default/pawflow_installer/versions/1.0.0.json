{
  "id": "pawflow-installer",
  "name": "pawflow_installer",
  "version": "1.0.0",
  "description": "First-run bootstrap wizard for a new PawFlow server. Configures gateway, auth, LLM services, summarizer, variables, secrets, CLI credential pools, and final flow deployment.",
  "parameters": {
    "port": "",
    "bootstrap_gateway_key": "RoyBatty",
    "bootstrap_gateway_secret_ref": "privategateway.bootstrap",
    "private_gateway_service_id": "_bootstrap_private_gateway",
    "ssl_certfile": "data/system/ssl/bootstrap.crt",
    "ssl_keyfile": "data/system/ssl/bootstrap.key"
  },
  "services": {
    "http_listener": {
      "type": "httpListener",
      "parameters": {
        "host": "0.0.0.0",
        "port": "${port}",
        "ssl_certfile": "${ssl_certfile}",
        "ssl_keyfile": "${ssl_keyfile}",
        "private_gateway_service_id": "${private_gateway_service_id}"
      }
    }
  },
  "tasks": {
    "http_in": {
      "type": "httpReceiver",
      "parameters": {
        "service_id": "http_listener",
        "routes": [
          {
            "method": "GET",
            "pattern": "/",
            "relationship": "GET:/",
            "public": true
          },
          {
            "method": "GET",
            "pattern": "/install",
            "relationship": "GET:/install",
            "public": true
          },
          {
            "method": "GET",
            "pattern": "/install/api",
            "relationship": "GET:/install/api",
            "public": true
          },
          {
            "method": "POST",
            "pattern": "/install/api/finalize",
            "relationship": "POST:/install/api/finalize",
            "public": true
          },
          {
            "method": "POST",
            "pattern": "/install/api/llm-credential/prepare",
            "relationship": "POST:/install/api/llm-credential/prepare",
            "public": true
          },
          {
            "method": "POST",
            "pattern": "/install/api/llm-credential/paste",
            "relationship": "POST:/install/api/llm-credential/paste",
            "public": true
          },
          {
            "method": "POST",
            "pattern": "/install/api/llm-credential/server-login",
            "relationship": "POST:/install/api/llm-credential/server-login",
            "public": true
          },
          {
            "method": "POST",
            "pattern": "/install/api/llm-credential/server-login/status",
            "relationship": "POST:/install/api/llm-credential/server-login/status",
            "public": true
          },
          {
            "method": "POST",
            "pattern": "/install/api/llm-credential/server-login/cleanup",
            "relationship": "POST:/install/api/llm-credential/server-login/cleanup",
            "public": true
          },
          {
            "method": "POST",
            "pattern": "/install/api/service-parameter-helper",
            "relationship": "POST:/install/api/service-parameter-helper",
            "public": true
          }
        ]
      },
      "label": "Http IN",
      "description": "Receives or initiates the http in step using httpReceiver."
    },
    "route_install": {
      "type": "routeOnAttribute",
      "parameters": {
        "routes": {
          "api_status": {
            "attribute": "http.path",
            "operator": "equals",
            "value": "/install/api"
          },
          "api_finalize": {
            "attribute": "http.path",
            "operator": "equals",
            "value": "/install/api/finalize"
          },
          "llm_credential_prepare": {
            "attribute": "http.path",
            "operator": "equals",
            "value": "/install/api/llm-credential/prepare"
          },
          "llm_credential_paste": {
            "attribute": "http.path",
            "operator": "equals",
            "value": "/install/api/llm-credential/paste"
          },
          "llm_credential_server_login": {
            "attribute": "http.path",
            "operator": "equals",
            "value": "/install/api/llm-credential/server-login"
          },
          "llm_credential_server_login_status": {
            "attribute": "http.path",
            "operator": "equals",
            "value": "/install/api/llm-credential/server-login/status"
          },
          "llm_credential_server_login_cleanup": {
            "attribute": "http.path",
            "operator": "equals",
            "value": "/install/api/llm-credential/server-login/cleanup"
          },
          "service_parameter_helper": {
            "attribute": "http.path",
            "operator": "equals",
            "value": "/install/api/service-parameter-helper"
          }
        },
        "default_relationship": "ui"
      },
      "label": "Route Install",
      "description": "Validates and routes the route install step using routeOnAttribute."
    },
    "install_ui": {
      "type": "generateFlowFile",
      "parameters": {
        "content_type": "text/html; charset=utf-8",
        "content_file": "install.html"
      },
      "label": "Install UI",
      "description": "Processes the install ui step using generateFlowFile."
    },
    "install_api": {
      "type": "installBootstrap",
      "parameters": {},
      "label": "Install API",
      "description": "Processes the install api step using installBootstrap."
    },
    "send_html": {
      "type": "handleHTTPResponse",
      "parameters": {
        "service_id": "http_listener",
        "content_type": "text/html; charset=utf-8"
      },
      "label": "Send Html",
      "description": "Delivers the send html step using handleHTTPResponse."
    },
    "send_json": {
      "type": "handleHTTPResponse",
      "parameters": {
        "service_id": "http_listener",
        "content_type": "application/json"
      },
      "label": "Send Json",
      "description": "Delivers the send json step using handleHTTPResponse."
    },
    "redirect_to_install": {
      "type": "handleHTTPResponse",
      "parameters": {
        "service_id": "http_listener",
        "status_code": 302,
        "content_type": "text/plain; charset=utf-8",
        "headers": {
          "Location": "/install",
          "Cache-Control": "no-store"
        }
      },
      "label": "Redirect TO Install",
      "description": "Delivers the redirect to install step using handleHTTPResponse."
    }
  },
  "relations": [
