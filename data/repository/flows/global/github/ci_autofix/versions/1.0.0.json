      "relation_id": "rel_5cad9286418a0230"
    },
    {
      "from": "route",
      "to": "finalize_ack",
      "type": "bad_sig",
      "relation_id": "rel_71eb510c222c3efa"
    },
    {
      "from": "route",
      "to": "finalize_ack",
      "type": "ignore",
      "relation_id": "rel_0a7a2d1fe4059e70"
    },
    {
      "from": "route",
      "to": "build_prompt",
      "type": "fix",
      "relation_id": "rel_d2945b21d8f92761"
    },
    {
      "from": "build_prompt",
      "to": "spawn_fix",
      "type": "success",
      "relation_id": "rel_0d0b8147026438ab"
    },
    {
      "from": "spawn_fix",
      "to": "finalize_ack",
      "type": "success",
      "relation_id": "rel_0edb985b12e53e9f"
    },
    {
      "from": "finalize_ack",
      "to": "respond",
      "type": "success",
      "relation_id": "rel_75e9987676563f8c"
    }
  ],
  "entries": [
    "webhook_in"
  ],
  "exits": [
    "respond"
  ],
