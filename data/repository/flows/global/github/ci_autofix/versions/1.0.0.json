{
  "id": "github-ci-autofix",
  "name": "ci_autofix",
  "version": "1.0.0",
  "description": "GitHub webhook (workflow_run) on the main PawFlow listener: verifies the HMAC signature, and when a CI run fails on the configured branch, injects a message into a configurable conversation asking the agent to fix and push. The webhook route is per-instance (/webhooks/github/<slot>), so multiple deploys/users never collide.",
  "parameters": {
    "port": "",
    "ci_branch": "main",
    "target_conversation_id": "",
    "target_user_id": "",
    "target_agent": "claude",
    "webhook_slot": "${_instance_id}"
  },
  "services": {
    "http_listener": {
      "type": "httpListener",
      "parameters": {
        "host": "0.0.0.0",
        "port": "${port}"
      }
    }
  },
  "tasks": {
    "webhook_in": {
      "type": "httpReceiver",
      "parameters": {
        "service_id": "http_listener",
        "routes": [
          {
            "method": "POST",
            "pattern": "/webhooks/github/${webhook_slot}",
            "relationship": "github_webhook",
            "public": true
          }
        ]
      },
      "label": "Webhook IN",
      "description": "Receives or initiates the webhook in step using httpReceiver."
    },
    "inject_secret": {
      "type": "updateAttribute",
      "parameters": {
        "set": {
          "webhook.secret": "${github_webhook_secret}"
        }
      },
      "label": "Inject Secret",
      "description": "Processes the inject secret step using updateAttribute."
    },
    "decide": {
      "type": "executeScript",
      "parameters": {
        "script_engine": "python",
        "script": "import hmac, hashlib, json\nsecret = (attributes.get('webhook.secret') or '')\nsig = (attributes.get('http.header.x-hub-signature-256') or '')\nraw = content.encode('utf-8')\nexpected = 'sha256=' + hmac.new(secret.encode('utf-8'), raw, hashlib.sha256).hexdigest()\nvalid = bool(secret) and bool(sig) and hmac.compare_digest(sig, expected)\ntarget_branch = '${ci_branch}'\ndecision = 'ignore'\nif not valid:\n    decision = 'bad_sig'\nelse:\n    try:\n        body = json.loads(content)\n    except Exception:\n        body = {}\n    wr = body.get('workflow_run') or {}\n    action = body.get('action', '')\n    branch = wr.get('head_branch', '')\n    conclusion = wr.get('conclusion', '')\n    repo = (body.get('repository') or {}).get('full_name', '')\n    flowfile.set_attribute('gh.action', action)\n    flowfile.set_attribute('gh.branch', branch)\n    flowfile.set_attribute('gh.conclusion', conclusion)\n    flowfile.set_attribute('gh.run_url', wr.get('html_url', ''))\n    flowfile.set_attribute('gh.sha', wr.get('head_sha', ''))\n    flowfile.set_attribute('gh.workflow', wr.get('name', ''))\n    flowfile.set_attribute('gh.run_id', str(wr.get('id', '')))\n    flowfile.set_attribute('gh.repo', repo)\n    if action == 'completed' and branch == target_branch and conclusion == 'failure':\n        decision = 'fix'\nflowfile.set_attribute('flow.decision', decision)\n"
      },
      "label": "Decide",
      "description": "Validates and routes the decide step using executeScript."
    },
    "route": {
      "type": "routeOnAttribute",
      "parameters": {
        "routing_strategy": "route_to_matched",
        "routes": {
          "bad_sig": {
            "attribute": "flow.decision",
            "operator": "equals",
            "value": "bad_sig"
          },
          "fix": {
            "attribute": "flow.decision",
            "operator": "equals",
            "value": "fix"
          },
          "ignore": {
            "attribute": "flow.decision",
            "operator": "equals",
            "value": "ignore"
          }
        },
        "default_relationship": "ignore"
      },
      "label": "Route",
      "description": "Validates and routes the route step using routeOnAttribute."
    },
    "build_prompt": {
      "type": "executeScript",
      "parameters": {
        "script_engine": "python",
        "script": "repo = attributes.get('gh.repo', '')\nbranch = attributes.get('gh.branch', '')\nrun_url = attributes.get('gh.run_url', '')\nsha = attributes.get('gh.sha', '')\nwf = attributes.get('gh.workflow', '')\nresult = (\n    'Le CI GitHub a echoue sur ' + repo + ' (branche ' + branch + ').\\n'\n    'Workflow: ' + wf + '\\n'\n    'Run: ' + run_url + '\\n'\n    'Commit: ' + sha + '\\n\\n'\n    'Analyse les logs du run echoue (gh run view --log-failed, ou via le web), identifie la cause racine, '\n    'corrige le code, puis commit + push la correction sur ' + branch + '.\\n'\n    'Garde-fou: si apres 3 tentatives le CI echoue toujours, arrete, ne repush pas, et signale le blocage.'\n)\n"
      },
      "label": "Build Prompt",
      "description": "Processes the build prompt step using executeScript."
    },
    "spawn_fix": {
      "type": "spawnAgent",
      "parameters": {
        "conversation_id": "${target_conversation_id}",
        "user_id": "${target_user_id}",
        "agent_name": "${target_agent}",
        "mode": "async",
        "context_mode": "isolated"
      },
      "label": "Spawn FIX",
      "description": "Processes the spawn fix step using spawnAgent."
    },
    "finalize_ack": {
      "type": "executeScript",
      "parameters": {
        "script_engine": "python",
        "script": "import json\ndecision = attributes.get('flow.decision', 'ignore')\nstatus = '401' if decision == 'bad_sig' else '200'\nflowfile.set_attribute('http.response.status', status)\nflowfile.set_attribute('http.response.header.Content-Type', 'application/json')\nlabel = {'bad_sig': 'rejected', 'fix': 'accepted', 'ignore': 'ignored'}.get(decision, 'ignored')\nresult = json.dumps({'status': label, 'decision': decision})\n"
      },
      "label": "Finalize ACK",
      "description": "Delivers the finalize ack step using executeScript."
    },
    "respond": {
      "type": "handleHTTPResponse",
      "parameters": {
        "service_id": "http_listener",
        "content_type": "application/json"
      },
      "label": "Respond",
      "description": "Delivers the respond step using handleHTTPResponse."
    }
  },
  "relations": [
    {
      "from": "webhook_in",
      "to": "inject_secret",
      "type": "github_webhook",
      "relation_id": "rel_b0e1c40934a05384"
    },
    {
      "from": "inject_secret",
      "to": "decide",
      "type": "success",
      "relation_id": "rel_25bb89ad140e8580"
    },
    {
      "from": "decide",
      "to": "route",
