{
  "id": "google-chat-agent",
  "name": "google_chat_agent",
  "version": "1.0.0",
  "description": "Owner-scoped Google Chat app with deny-by-default space authorization and shared PawFlow agent runtime.",
  "parameters": {
    "service_account_json": {
      "type": "string",
      "default": "",
      "sensitive": true,
      "required": true,
      "description": "Google Cloud service-account JSON for the Chat app."
    },
    "google_chat_audience": {
      "type": "string",
      "default": "",
      "required": true,
      "description": "Expected audience in Google-signed interaction tokens."
    },
    "google_chat_audience_type": {
      "type": "string",
      "default": "endpoint_url",
      "required": false,
      "description": "Google Chat authentication audience type: endpoint_url (recommended) or project_number."
    },
    "owner_google_user_id": {
      "type": "string",
      "default": "",
      "required": true,
      "description": "Immutable Google Chat owner identity, for example users/123456."
    },
    "direct_conversation_id": {
      "type": "string",
      "default": "",
      "required": false,
      "description": "Existing owner conversation used for direct messages."
    },
    "http_host": "0.0.0.0",
    "http_port": 8080,
    "webhook_slot": "${_instance_id}",
    "agent_runtime_port": "pawflow_agent.agent_runtime_in"
  },
  "runtime_links": [
    {
      "from": "agent_client",
      "to": "${agent_runtime_port}",
      "type": "agentRuntime",
      "description": "Submit Google Chat messages to the shared PawFlow runtime"
    }
  ],
  "services": {
    "http_listener": {
      "type": "httpListener",
      "parameters": {"host": "${http_host}", "port": "${http_port}"}
    },
    "google_chat": {
      "type": "googleChatBot",
      "parameters": {
        "service_account_json": "${service_account_json}",
        "audience": "${google_chat_audience}",
        "audience_type": "${google_chat_audience_type}"
      }
    }
  },
  "tasks": {
    "receive": {
      "type": "httpReceiver",
      "parameters": {
        "service_id": "http_listener",
        "routes": [{
          "method": "POST",
          "pattern": "/webhooks/google-chat/${webhook_slot}",
          "relationship": "google_chat_event",
          "public": true
        }]
      }
    },
    "verify_and_ack": {
      "type": "googleChatWebhook",
      "parameters": {
        "service_id": "google_chat",
        "http_service_id": "http_listener"
      }
    },
    "agent_client": {
      "type": "googleChatAgentClient",
      "max_instances": 20,
      "parameters": {
        "service_id": "google_chat",
        "owner_google_user_id": "${owner_google_user_id}",
        "direct_conversation_id": "${direct_conversation_id}",
        "agent_runtime_port": "${agent_runtime_port}"
      }
    }
  },
  "fqn": "google_chat.google_chat_agent:1.0.0",
  "package": "google_chat",
  "relations": [
    {"source": "receive", "target": "verify_and_ack", "relationships": ["success"]},
    {"source": "verify_and_ack", "target": "agent_client", "relationships": ["success"]}
  ]
}
