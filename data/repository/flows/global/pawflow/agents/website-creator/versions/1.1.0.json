{
  "id": "website-creator",
  "name": "Website Creator",
  "version": "1.1.0",
  "fqn": "pawflow.agents.website-creator:1.1.0",
  "kind": "agent_workflow",
  "description": "Durable Website Creator 1.1 inventories an accepted public site, maps and builds every page in bounded replayable batches, preserves authorized assets, finalizes static links deterministically, and repeats visual review and correction until explicit acceptance.",
  "agent_contract": {
    "version": 1,
    "input": {
      "port": "agent_request"
    },
    "terminal": {
      "port": "agent_terminal"
    },
    "parameters": {
      "creator_llm": {
        "type": "service_ref",
        "capability": "llm_resolvable",
        "required": true,
        "label": "Creator LLM",
        "description": "Vision-capable LLM used for bounded exploration, page batches and review."
      },
      "relay": {
        "type": "string",
        "required": false,
        "label": "Website relay",
        "description": "Optional exact linked relay providing public HTTP, Chromium and filesystem access."
      },
      "source_url": {
        "type": "string",
        "required": false,
        "label": "Source website URL",
        "description": "Optional public HTTP(S) source URL; otherwise extracted from the request."
      },
      "template_url": {
        "type": "string",
        "required": false,
        "label": "Template website URL",
        "description": "Optional immutable reviewed template URL; otherwise extracted from the request."
      },
      "workspace_root": {
        "type": "string",
        "required": false,
        "default": "/workspace/pawflow-sites",
        "label": "Project workspace root",
        "description": "Absolute relay directory containing one stable run-scoped project."
      },
      "crawl": {
        "type": "object",
        "required": false,
        "default": {
          "max_pages": 100,
          "max_depth": 3,
          "politeness_delay_ms": 750,
          "request_timeout_seconds": 30,
          "max_total_bytes": 268435456,
          "max_duration_seconds": 1800,
          "include_url_patterns": [],
          "exclude_url_patterns": []
        },
        "label": "Crawl contract",
        "description": "Optional explicit bounds and source-rights declaration; incomplete input opens the durable confirmation gate."
      }
    },
    "supported_preempt_policies": [
      "checkpoint",
      "queue"
    ],
    "allowed_effects": [
      "resource.read",
      "resource.write",
      "messaging.send",
      "network.read",
      "network.write",
      "browser.control",
      "filesystem.read",
      "filesystem.write",
      "external.side_effect"
    ]
  },
  "parameters": {},
  "services": {},
  "entries": [
    "agent_request"
  ],
  "exits": [
    "agent_terminal"
  ],
  "tasks": {
    "agent_request": {
      "type": "inputPort",
      "label": "Receive website request",
      "description": "Accept one bounded source-to-template creation request and its run context.",
      "parameters": {
        "port_name": "agent_request"
      }
    },
    "validate_request": {
      "type": "agentWorkflowInput",
      "label": "Validate request identity",
      "description": "Validate server-owned conversation, agent and root-turn identity before any access.",
      "parameters": {}
    },
    "prepare_request": {
      "type": "prepareWebsiteRequest",
      "label": "Validate URLs and workspace",
      "description": "Require two public HTTP(S) URLs, parse crawl inputs and reserve the stable run workspace.",
      "parameters": {
        "workspace_root": "${workspace_root}"
      }
    },
    "prepare_crawl_decision": {
      "type": "prepareCrawlDecision",
      "label": "Confirm crawl contract",
      "description": "Route a fully explicit crawl contract or prepare the bounded approval form.",
      "parameters": {
        "output_attribute": "website.crawl_decision"
      }
    },
    "request_crawl_limits": {
      "type": "requestUserInput",
      "label": "Request crawl limits and rights",
      "description": "Publish effective crawl bounds and source-rights policy for durable approval.",
      "parameters": {
        "message": "Review Website Creator crawl limits and source rights.",
        "title": "Confirm Website Creator crawl",
        "kind": "form",
        "response_schema": {
          "fields": []
        },
        "payload_attribute": "website.crawl_decision",
        "requester_label": "Website Creator"
      }
    },
    "wait_crawl_limits": {
      "type": "durableWait",
      "label": "Wait for crawl approval",
      "description": "Park the run durably until crawl limits and source rights are confirmed.",
      "parameters": {
        "signal_id_attribute": "interaction.signal_id"
      }
    },
    "apply_crawl_limits": {
      "type": "applyCrawlDecision",
      "label": "Apply crawl decision",
      "description": "Freeze confirmed bounds and rights, or stop before any network access.",
      "parameters": {}
    },
    "initialize_site_crawl": {
      "type": "initializeSiteCrawl",
      "label": "Initialize site inventory",
      "description": "Create, resume, or verify the run-scoped crawl manifest.",
      "parameters": {}
    },
    "fetch_crawl_entry": {
      "type": "fetchSiteCrawlEntry",
      "label": "Fetch one crawl entry",
      "description": "Perform one bounded public fetch and checkpoint its records.",
      "parameters": {}
    },
    "route_crawl_state": {
      "type": "routeSiteCrawl",
      "label": "Route crawl checkpoint",
      "description": "Route queued, complete, bounded, or error inventory state.",
      "parameters": {}
    },
    "wait_crawl_delay": {
      "type": "durableTimer",
      "label": "Wait for crawl politeness deadline",
      "description": "Park without blocking a worker until the next approved same-origin request.",
      "parameters": {
        "until": "${website.crawl.next_allowed_at}"
      }
    },
    "prepare_inventory_decision": {
      "type": "prepareInventoryDecision",
      "label": "Review inventory completeness",
      "description": "Route a complete inventory or prepare bounded/error omission approval.",
      "parameters": {
        "output_attribute": "website.inventory_decision"
      }
    },
    "request_inventory_approval": {
      "type": "requestUserInput",
      "label": "Request inventory approval",
      "description": "Publish bounded crawl omissions and choices for a durable decision.",
      "parameters": {
        "message": "Review Website Creator inventory completeness.",
        "title": "Approve Website Creator inventory",
        "kind": "form",
        "response_schema": {
          "fields": []
        },
        "payload_attribute": "website.inventory_decision",
        "requester_label": "Website Creator"
      }
    },
    "wait_inventory_approval": {
      "type": "durableWait",
      "label": "Wait for inventory approval",
      "description": "Park until omissions are accepted, limits are adjusted, or work is stopped.",
      "parameters": {
        "signal_id_attribute": "interaction.signal_id"
      }
    },
    "apply_inventory_decision": {
      "type": "applyInventoryDecision",
      "label": "Apply inventory decision",
      "description": "Persist accepted omissions, request a fresh bounded crawl, or stop.",
      "parameters": {}
    },
    "explore_sites": {
      "type": "websiteCreatorTool",
      "label": "Explore source and template",
      "description": "Inspect both public sites visually and gather bounded rendered evidence.",
      "parameters": {
        "service": "${creator_llm}",
        "phase": "explore",
        "required_tools": [
          "screen",
          "see"
        ],
        "max_iterations": 0,
        "max_tokens": 0,
        "temperature": 0.15
      }
    },
    "prepare_mapping_batches": {
      "type": "prepareWebsiteMappingBatches",
      "label": "Prepare mapping batches",
      "description": "Partition accepted inventory pages into stable batches of at most 25.",
      "parameters": {}
    },
    "map_page_batch": {
      "type": "mapWebsitePageBatch",
      "label": "Map current page batch",
      "description": "Map exactly the current file-backed batch through the constrained visual phase.",
      "parameters": {
        "service": "${creator_llm}",
        "phase": "explore",
        "required_tools": [
          "screen",
          "see"
        ],
        "max_iterations": 0,
        "max_tokens": 0,
        "temperature": 0.15
      }
    },
    "route_mapping_batches": {
      "type": "routeWebsiteBatches",
      "label": "Route mapping batches",
      "description": "Continue with the next mapping batch or merge exact coverage.",
      "parameters": {
        "phase": "mapping"
      }
    },
    "merge_mapping": {
      "type": "mergeWebsiteMapping",
      "label": "Merge complete mapping",
      "description": "Verify exactly-once mapping coverage and write a bounded approval summary.",
      "parameters": {}
    },
    "prepare_mapping_decision": {
      "type": "prepareWebsiteDecision",
      "label": "Present mapping summary",
      "description": "Build the durable mapping approval form with links to full file-backed results.",
      "parameters": {
        "decision": "mapping",
        "output_attribute": "website.mapping_decision"
      }
    },
    "request_mapping_approval": {
      "type": "requestUserInput",
      "label": "Request mapping approval",
      "description": "Publish the complete mapping summary and allow approval or rejection.",
      "parameters": {
        "message": "Review the proposed website mapping.",
        "title": "Approve website mapping",
        "kind": "form",
        "response_schema": {
          "fields": []
        },
        "payload_attribute": "website.mapping_decision",
        "requester_label": "Website Creator"
      }
    },
    "wait_mapping_approval": {
      "type": "durableWait",
      "label": "Wait for mapping approval",
      "description": "Park the run durably before template or site files are materialized.",
      "parameters": {
        "signal_id_attribute": "interaction.signal_id"
      }
    },
    "apply_mapping_decision": {
      "type": "applyWebsiteDecision",
      "label": "Apply mapping decision",
      "description": "Validate approval; rejection stops without writing the generated site.",
      "parameters": {
        "decision": "mapping"
      }
    },
    "download_template": {
      "type": "downloadTemplate",
      "label": "Download pinned template",
      "description": "Fetch, hash-verify and safely extract the immutable reviewed template artifact.",
      "parameters": {}
    },
    "prepare_build_batches": {
      "type": "prepareWebsiteBuildBatches",
      "label": "Prepare build batches",
      "description": "Partition the approved mapping into stable batches of at most 25.",
      "parameters": {}
    },
    "build_page_batch": {
      "type": "buildWebsitePageBatch",
      "label": "Build current page batch",
      "description": "Implement exactly the current approved page batch in the scoped workspace.",
      "parameters": {
        "service": "${creator_llm}",
        "phase": "build",
        "max_iterations": 0,
        "max_tokens": 0,
        "temperature": 0.15
      }
    },
    "route_build_batches": {
      "type": "routeWebsiteBatches",
      "label": "Route build batches",
      "description": "Continue with the next build batch or merge exact coverage.",
      "parameters": {
        "phase": "build"
      }
    },
    "merge_build": {
      "type": "mergeWebsiteBuild",
      "label": "Merge complete build",
      "description": "Verify exactly-once build coverage and aggregate bounded results.",
      "parameters": {}
    },
    "finalize_static_site": {
      "type": "finalizeStaticSite",
      "label": "Finalize static site",
      "description": "Rewrite HTML/CSS through accepted manifests and enforce deterministic completeness.",
      "parameters": {}
    },
    "review_site": {
      "type": "websiteCreatorTool",
      "label": "Review rendered website",
      "description": "Visually inspect only a deterministically complete site against approved checks.",
      "parameters": {
        "service": "${creator_llm}",
        "phase": "review",
        "required_tools": [
          "screen",
          "see"
        ],
        "max_iterations": 0,
        "max_tokens": 0,
        "temperature": 0.1
      }
    },
    "prepare_review_decision": {
      "type": "prepareWebsiteDecision",
      "label": "Route reviewer verdict",
      "description": "Return visual failures to correction; only a pass may request user acceptance.",
      "parameters": {
        "decision": "review",
        "output_attribute": "website.review_decision"
      }
    },
    "request_final_review": {
      "type": "requestUserInput",
      "label": "Request final acceptance",
      "description": "Let the user accept the reviewer-approved site or request further corrections.",
      "parameters": {
        "message": "Review the generated website.",
        "title": "Accept generated website",
        "kind": "form",
        "response_schema": {
          "fields": []
        },
        "payload_attribute": "website.review_decision",
        "requester_label": "Website Creator"
      }
    },
    "wait_final_review": {
      "type": "durableWait",
      "label": "Wait for final review",
      "description": "Park until the site is accepted or another correction is requested.",
      "parameters": {
        "signal_id_attribute": "interaction.signal_id"
      }
    },
    "apply_review_decision": {
      "type": "applyWebsiteDecision",
      "label": "Apply final decision",
      "description": "Route accepted work to delivery or authorize another correction pass.",
      "parameters": {
        "decision": "review"
      }
    },
    "prepare_correction_batches": {
      "type": "prepareWebsiteCorrectionBatches",
      "label": "Prepare correction batches",
      "description": "Derive affected page batches from deterministic, visual, or explicit global issues.",
      "parameters": {}
    },
    "correct_page_batch": {
      "type": "correctWebsitePageBatch",
      "label": "Correct current page batch",
      "description": "Apply the exact current correction checklist inside the run workspace.",
      "parameters": {
        "service": "${creator_llm}",
        "phase": "correct",
        "max_iterations": 0,
        "max_tokens": 0,
        "temperature": 0.1
      }
    },
    "route_correction_batches": {
      "type": "routeWebsiteBatches",
      "label": "Route correction batches",
      "description": "Continue with the next affected batch or merge correction coverage.",
      "parameters": {
        "phase": "correction"
      }
    },
    "merge_correction": {
      "type": "mergeWebsiteCorrection",
      "label": "Merge corrections",
      "description": "Verify affected-page coverage before deterministic re-finalization.",
      "parameters": {}
    },
    "format_result": {
      "type": "formatWebsiteCreatorResult",
      "label": "Format website result",
      "description": "Return the stable workspace, manifests, finalization summary and bounded metrics.",
      "parameters": {}
    },
    "complete_turn": {
      "type": "completeAgentTurn",
      "label": "Commit terminal result",
      "description": "Validate and stage the sole Website Creator terminal result.",
      "parameters": {}
    },
    "agent_terminal": {
      "type": "outputPort",
      "label": "Return Website Creator result",
      "description": "Emit the single terminal result to the Workflow Agent runtime.",
      "parameters": {
        "port_name": "agent_terminal"
      }
    }
  },
