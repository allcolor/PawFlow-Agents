        "receive_corrections": {"x": 1040, "y": 665},
        "plan_patch": {"x": 1040, "y": 955},
        "validate_patch": {"x": 790, "y": 955},
        "prepare_review": {"x": 540, "y": 955},
        "review_patch": {"x": 290, "y": 955},
        "validate_review": {"x": 40, "y": 955},
        "apply_patch": {"x": 40, "y": 1245},
