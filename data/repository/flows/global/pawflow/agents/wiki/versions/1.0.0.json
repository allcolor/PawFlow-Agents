        "agent_terminal": {"x": 1040, "y": 1245}
      },
      "relations": {},
      "annotations": {},
      "frames": {
        "request_gate": {
          "id": "request_gate", "label": "1. Request gate",
          "description": "Validate and classify the request before any project source is accessed.",
          "x": 0, "y": 0, "width": 1290, "height": 250, "z_index": -10,
          "member_ids": ["agent_request", "validate_request", "prepare_intent", "infer_intent", "route_intent"],
          "style": {"fill": "#171d33", "border": "#53679f", "opacity": 0.9}
        },
        "source_snapshot": {
          "id": "source_snapshot", "label": "2. Source snapshot",
          "description": "Select, fetch and normalize a bounded immutable source snapshot.",
          "x": 0, "y": 290, "width": 1290, "height": 250, "z_index": -10,
          "member_ids": ["scan_sources", "select_batch", "fetch_sources", "normalize_sources"],
          "style": {"fill": "#14262d", "border": "#3f7f80", "opacity": 0.9}
        },
        "evidence": {
          "id": "evidence", "label": "3. Evidence extraction",
          "description": "Extract source-cited facts, merge the batches and absorb bounded corrections.",
          "x": 0, "y": 580, "width": 1290, "height": 250, "z_index": -10,
          "member_ids": ["split_batches", "extract_facts", "merge_extractions", "receive_corrections"],
          "style": {"fill": "#24203a", "border": "#765f9f", "opacity": 0.9}
        },
        "authoring_review": {
          "id": "authoring_review", "label": "4. Authoring and review",
          "description": "Draft a complete wiki patch, validate citations and run the optional semantic review.",
          "x": 0, "y": 870, "width": 1290, "height": 250, "z_index": -10,
          "member_ids": ["plan_patch", "validate_patch", "prepare_review", "review_patch", "validate_review"],
          "style": {"fill": "#2d2028", "border": "#9a5f78", "opacity": 0.9}
        },
        "delivery": {
          "id": "delivery", "label": "5. Apply and report",
          "description": "Apply or shadow the patch, lint the wiki and return the durable terminal result.",
          "x": 0, "y": 1160, "width": 1290, "height": 250, "z_index": -10,
          "member_ids": ["apply_patch", "lint_wiki", "format_report", "complete_turn", "agent_terminal"],
          "style": {"fill": "#29291d", "border": "#8d8a48", "opacity": 0.9}
        }
      }
    }
  },
