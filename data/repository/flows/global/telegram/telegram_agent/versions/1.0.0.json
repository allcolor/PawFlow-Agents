{
  "id": "telegram-agent",
  "name": "telegram_agent",
  "version": "1.0.0",
  "description": "Telegram client for the shared PawFlow agent runtime. Messages are submitted through the same API contract used by webchat, PawCode, and VSCode.",
  "parameters": {
    "bot_token": {
      "type": "string",
      "default": "",
      "sensitive": true,
      "required": true,
      "description": "Telegram Bot API token"
    },
    "agent_runtime_port": "pawflow_agent.agent_runtime_in"
  },
  "runtime_links": [
    {
      "from": "agent_client",
      "to": "${agent_runtime_port}",
      "type": "agentRuntime",
      "description": "Submit Telegram messages to the shared PawFlow agent runtime"
    }
  ],
  "services": {
    "telegram_bot": {
      "type": "telegramBot",
      "parameters": {
        "bot_token": "${bot_token}",
        "poll_timeout": 30
      }
    }
  },
  "tasks": {
    "receive": {
      "type": "telegramReceiver",
      "parameters": {
        "service_id": "telegram_bot"
      },
      "label": "Receive",
      "description": "Receives or initiates the receive step using telegramReceiver."
    },
    "agent_client": {
      "type": "telegramAgentClient",
      "max_instances": 20,
      "parameters": {
        "agent_runtime_port": "${agent_runtime_port}",
        "service_id": "telegram_bot"
      },
      "label": "Agent Client",
      "description": "Processes the agent client step using telegramAgentClient."
    },
    "send_reply": {
      "type": "telegramSend",
      "parameters": {
        "service_id": "telegram_bot",
        "chat_id": "${telegram.chat_id}",
        "parse_mode": "Markdown"
      },
      "label": "Send Reply",
      "description": "Delivers the send reply step using telegramSend."
    },
    "conversation_bridge": {
      "type": "telegramConversationBridge",
      "parameters": {
        "service_id": "telegram_bot"
      },
      "label": "Conversation Bridge",
      "description": "Processes the conversation bridge step using telegramConversationBridge."
    }
  },
  "fqn": "telegram.telegram_agent:1.0.0",
  "package": "telegram",
  "relations": [
    {
      "source": "receive",
      "target": "agent_client",
      "relationships": [
        "success"
      ],
      "relation_id": "rel_57f89fc66cdb80d1"
