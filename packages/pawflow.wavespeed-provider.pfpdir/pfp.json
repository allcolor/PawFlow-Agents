      "id": "service_provider:image",
      "type": "service_provider",
      "name": "WaveSpeedAI Image Generation",
      "service_type": "wavespeedImageGeneration",
      "path": "content/runtime/provider.py",
      "runner": "python",
      "description": "WaveSpeedAI Image Generation",
      "category": "image",
      "parameters": {
        "api_key": {
          "description": "WaveSpeedAI API key.",
          "required": true,
          "sensitive": true,
          "type": "string"
        },
        "max_retries": {
          "default": 3,
          "description": "Submit/poll retry count for transient 5xx responses.",
          "required": false,
          "type": "integer"
        },
        "model": {
          "default": "wavespeed-ai/flux-dev",
          "description": "WaveSpeed model id (see wavespeed_catalog.json, category=image).",
          "required": true,
          "type": "string"
        },
        "poll_interval": {
          "default": 3,
          "description": "Seconds between prediction status checks.",
          "required": false,
          "type": "integer"
        },
        "public_callback_base_url": {
          "default": "",
          "description": "Public HTTPS base URL that WaveSpeedAI can POST callbacks to, e.g. https://webchat.example.org. Falls back to the agent runtime file_base_url when omitted.",
          "required": false,
          "type": "string"
        },
        "timeout": {
          "default": 120,
          "description": "HTTP timeout in seconds.",
          "required": false,
          "type": "integer"
        },
        "use_webhook": {
          "default": false,
          "description": "Use WaveSpeedAI's webhook query parameter instead of polling. Requires PawFlow to be reachable from the internet through public_callback_base_url or the agent file_base_url.",
          "required": false,
          "type": "boolean"
        }
      },
      "operations": {
        "generate": {},
        "edit_image": {}
      },
      "provides": [
        "media.image_generation"
      ]
    },
