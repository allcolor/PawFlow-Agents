{
  "id": "website-creator",
  "name": "Website Creator",
  "version": "1.0.0",
  "fqn": "pawflow.agents.website-creator:1.0.0",
  "kind": "agent_workflow",
  "description": "Durable desktop-first workflow that maps a public source site into a public template, preserves authorized source images, builds a scoped static site, and repeats visual review and correction until explicit acceptance.",
  "agent_contract": {
    "version": 1,
    "input": {
      "port": "agent_request"
    },
    "terminal": {
      "port": "agent_terminal"
    },
    "parameters": {
      "creator_llm": {
        "type": "service_ref",
        "capability": "llm_resolvable",
        "required": true,
        "label": "Creator LLM",
        "description": "Vision-capable LLM used for bounded desktop exploration, implementation and review."
      },
      "relay": {
        "type": "string",
        "required": false,
        "label": "Website relay",
        "description": "Optional exact linked relay providing Chromium and filesystem access."
      },
      "source_url": {
        "type": "string",
        "required": false,
        "label": "Source website URL",
        "description": "Optional public HTTP(S) source URL; otherwise extracted from the request."
      },
      "template_url": {
        "type": "string",
        "required": false,
        "label": "Template website URL",
        "description": "Optional public HTTP(S) template URL; otherwise extracted from the request."
      },
      "workspace_root": {
        "type": "string",
        "required": false,
        "default": "/workspace/pawflow-sites",
        "label": "Project workspace root",
        "description": "Absolute relay directory under which one stable run-scoped project is created."
      }
    },
    "supported_preempt_policies": [
      "checkpoint",
      "queue"
    ],
    "allowed_effects": [
      "resource.read",
      "resource.write",
      "messaging.send",
      "network.write",
      "filesystem.read",
      "filesystem.write",
      "external.side_effect"
    ]
  },
  "parameters": {},
  "services": {},
  "entries": [
    "agent_request"
  ],
  "exits": [
    "agent_terminal"
  ],
  "tasks": {
    "agent_request": {
      "type": "inputPort",
      "label": "Receive website request",
      "description": "Accept one bounded source-to-template creation request and its run context.",
      "parameters": {
        "port_name": "agent_request"
      }
    },
    "validate_request": {
      "type": "agentWorkflowInput",
      "label": "Validate request identity",
      "description": "Validate server-owned conversation, agent and root-turn identity before any access.",
      "parameters": {}
    },
    "prepare_request": {
      "type": "prepareWebsiteRequest",
      "label": "Validate URLs and workspace",
      "description": "Require two public HTTP(S) URLs, block private targets and reserve the stable run workspace.",
      "parameters": {
        "workspace_root": "${workspace_root}"
      }
    },
    "explore_sites": {
      "type": "websiteCreatorTool",
      "label": "Explore source and template",
      "description": "Inspect both sites through Chromium screen and vision, with fetch only as supplementary evidence.",
      "parameters": {
        "service": "${creator_llm}",
        "phase": "explore",
        "required_tools": [
          "screen",
          "see"
        ],
        "max_iterations": 16,
        "max_tokens": 5000,
        "temperature": 0.15
      }
    },
    "prepare_mapping_decision": {
      "type": "prepareWebsiteDecision",
      "label": "Present source-template mapping",
      "description": "Build a bounded form containing the visual mapping, implementation plan, checks and risks.",
      "parameters": {
        "decision": "mapping",
        "output_attribute": "website.mapping_decision"
      }
    },
    "request_mapping_approval": {
      "type": "requestUserInput",
      "label": "Request mapping approval",
      "description": "Publish the proposed mapping and allow approval or rejection with feedback.",
      "parameters": {
        "message": "Review the proposed website mapping.",
        "title": "Approve website mapping",
        "kind": "form",
        "response_schema": {
          "fields": []
        },
        "payload_attribute": "website.mapping_decision",
        "requester_label": "Website Creator"
      }
    },
    "wait_mapping_approval": {
      "type": "durableWait",
      "label": "Wait for mapping approval",
      "description": "Park the run durably before any project files are written.",
      "parameters": {
        "signal_id_attribute": "interaction.signal_id"
      }
    },
    "apply_mapping_decision": {
      "type": "applyWebsiteDecision",
      "label": "Apply mapping decision",
      "description": "Validate the durable approval; rejection stops without writing the project.",
      "parameters": {
        "decision": "mapping"
      }
    },
    "build_site": {
      "type": "websiteCreatorTool",
      "label": "Build website project",
      "description": "Implement the approved mapping in the stable run workspace and run relevant checks.",
      "parameters": {
        "service": "${creator_llm}",
        "phase": "build",
        "max_iterations": 20,
        "max_tokens": 6000,
        "temperature": 0.15
      }
    },
    "review_site": {
      "type": "websiteCreatorTool",
      "label": "Review rendered website",
      "description": "Inspect the generated site through the visible desktop and vision against approved checks.",
      "parameters": {
        "service": "${creator_llm}",
        "phase": "review",
        "required_tools": [
          "screen",
          "see"
        ],
        "max_iterations": 12,
        "max_tokens": 4500,
        "temperature": 0.1
      }
    },
    "prepare_review_decision": {
      "type": "prepareWebsiteDecision",
      "label": "Present final review",
      "description": "Build a bounded form containing preview information, passed checks and actionable issues.",
      "parameters": {
        "decision": "review",
        "output_attribute": "website.review_decision"
      }
    },
    "request_final_review": {
      "type": "requestUserInput",
      "label": "Request final acceptance",
      "description": "Let the user accept the site or request another correction with feedback.",
      "parameters": {
        "message": "Review the generated website.",
        "title": "Accept generated website",
        "kind": "form",
        "response_schema": {
          "fields": []
        },
        "payload_attribute": "website.review_decision",
        "requester_label": "Website Creator"
      }
    },
    "wait_final_review": {
      "type": "durableWait",
      "label": "Wait for final review",
      "description": "Park the run durably until the website is accepted or another correction is requested.",
      "parameters": {
        "signal_id_attribute": "interaction.signal_id"
      }
    },
    "apply_review_decision": {
      "type": "applyWebsiteDecision",
      "label": "Apply final decision",
      "description": "Route accepted work to delivery or authorize another bounded correction pass.",
      "parameters": {
        "decision": "review"
      }
    },
    "correct_site": {
      "type": "websiteCreatorTool",
      "label": "Apply requested corrections",
      "description": "Apply the latest feedback, validate the project and return to visual review.",
      "parameters": {
        "service": "${creator_llm}",
        "phase": "correct",
        "max_iterations": 12,
        "max_tokens": 5500,
        "temperature": 0.1
      }
    },
    "format_result": {
      "type": "formatWebsiteCreatorResult",
      "label": "Format website result",
      "description": "Return the stable project workspace, validation summary and bounded metrics.",
      "parameters": {}
    },
    "complete_turn": {
      "type": "completeAgentTurn",
      "label": "Commit terminal result",
      "description": "Validate and stage the sole Website Creator terminal result.",
      "parameters": {}
    },
    "agent_terminal": {
      "type": "outputPort",
      "label": "Return Website Creator result",
      "description": "Emit the single terminal result to the workflow-agent runtime.",
      "parameters": {
        "port_name": "agent_terminal"
      }
    }
  },
